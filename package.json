{
  "name": "athenai-transit",
  "private": true,
  "version": "2026.08.02",
  "description": "'Athenai Transit' is a web application that helps users explore transit options without specifying a destination.",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "gtfs",
    "gtfs-jp",
    "transit",
    "bus",
    "typescript",
    "nodejs"
  ],
  "author": "F88 <685250+F88@users.noreply.github.com>",
  "homepage": "https://github.com/F88/athenai-transit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F88/athenai-transit.git"
  },
  "bugs": {
    "url": "https://github.com/F88/athenai-transit/issues"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "generate-pwa-assets": "pwa-assets-generator",
    "storybook": "STORYBOOK=1 storybook dev -p 6006",
    "build-storybook": "STORYBOOK=1 storybook build",
    "pipeline:download:gtfs": "npx tsx --env-file-if-exists=pipeline/.env.pipeline.local pipeline/scripts/pipeline/download-gtfs.ts --targets pipeline/config/targets/download-gtfs.ts",
    "pipeline:download:odpt-json": "npx tsx --env-file-if-exists=pipeline/.env.pipeline.local pipeline/scripts/pipeline/download-odpt-json.ts --targets pipeline/config/targets/download-odpt-json.ts",
    "pipeline:build:db": "npx tsx pipeline/scripts/pipeline/build-gtfs-db.ts --targets pipeline/config/targets/build-db.ts",
    "pipeline:build:v2-data": "npx tsx pipeline/scripts/pipeline/app-data-v2/build-from-gtfs.ts --targets pipeline/config/targets/build-json.ts",
    "pipeline:build:v2-odpt-train": "npx tsx pipeline/scripts/pipeline/app-data-v2/build-from-odpt-train.ts --targets pipeline/config/targets/build-odpt-train.ts",
    "pipeline:build:v2-shapes:gtfs": "npx tsx pipeline/scripts/pipeline/app-data-v2/build-shapes-from-gtfs.ts --targets pipeline/config/targets/build-shapes-gtfs.ts",
    "pipeline:build:v2-shapes:ksj": "npx tsx pipeline/scripts/pipeline/app-data-v2/build-shapes-from-ksj-railway.ts --targets pipeline/config/targets/build-shapes-ksj.ts",
    "pipeline:build:v2-insights": "npx tsx pipeline/scripts/pipeline/app-data-v2/build-insights.ts --targets pipeline/config/targets/build-insights.ts",
    "pipeline:build:v2-global-insights": "npx tsx pipeline/scripts/pipeline/app-data-v2/build-global-insights.ts --targets pipeline/config/targets/build-global-insights.ts",
    "pipeline:build:v2-data-source-catalog": "npx tsx pipeline/scripts/pipeline/app-data-v2/build-data-source-catalog.ts --targets pipeline/config/targets/build-data-source-catalog.ts",
    "pipeline:validate:v2": "npx tsx pipeline/scripts/pipeline/app-data-v2/validate-v2-bundles.ts --targets pipeline/config/targets/validate.ts",
    "pipeline:deliver:local": "npx tsx --env-file-if-exists=pipeline/.env.pipeline.local pipeline/scripts/pipeline/copy-pipeline-data.ts",
    "pipeline:check:odpt-resources": "npx tsx pipeline/scripts/pipeline/check-odpt-resources.ts",
    "pipeline:dev-tools": "npx tsx pipeline/scripts-for-dev/dev-tools.ts",
    "pipeline:dev-tools:resource": "npx tsx pipeline/scripts-for-dev/describe-resources.ts",
    "vercel:blob:upload": "npx tsx --env-file-if-exists=pipeline/.env.pipeline.local pipeline/scripts/pipeline/vercel-blob/upload-data-to-blob.ts",
    "vercel:blob:delete": "npx tsx --env-file-if-exists=pipeline/.env.pipeline.local pipeline/scripts/pipeline/vercel-blob/delete-data-from-blob.ts",
    "vercel:blob:list": "npx tsx --env-file-if-exists=pipeline/.env.pipeline.local pipeline/scripts/pipeline/vercel-blob/list-data-in-blob.ts",
    "vercel:deployment:cleanup": "node ops/cleanup-vercel-deployments.mjs --dry-run",
    "vercel:deployment:cleanup:run": "node ops/cleanup-vercel-deployments.mjs"
  },
  "dependencies": {
    "@holiday-jp/holiday_jp": "^2.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "geolib": "^3.3.14",
    "i18next": "^26.3.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.22.0",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/blob": "^2.6.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "adm-zip": "^0.5.18",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.4.6",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.12.0",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  }
}
