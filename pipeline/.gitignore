### Pipeline files and directories

## Reference documents for development and testing (not needed in production)
_references/

# Pipeline local env (contains API tokens)
.env.pipeline.*
# Exception: the committed template (no secrets) documenting the variables.
!.env.pipeline.example

## Pipeline workspace (contains intermediate files and outputs; not needed in production)

# Pipeline archives (downloaded ZIP/JSON originals)
workspace/_archives/

# Pipeline build artifacts (SQLite databases)
workspace/_build/

# Large sources (re-downloadable). Match direct children so re-include
# rules below can resurface specific files (git cannot re-include a path
# whose parent directory is excluded).
workspace/data/*

# Exception: KSJ railway data is checked in (small, manual yearly update; Issue #74).
!workspace/data/mlit/
workspace/data/mlit/*
!workspace/data/mlit/N02-*_RailroadSection.geojson
