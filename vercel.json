{
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/data-v2/:path*",
        "destination": "https://q7b6o26cj43mlftk.public.blob.vercel-storage.com/:path*"
      }
    ],
    "afterFiles": [
      {
        "source": "/data-v3/:path*",
        "destination": "https://q7b6o26cj43mlftk.public.blob.vercel-storage.com/:path*"
      },
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ]
  },
  "headers": [
    {
      "source": "/data-v3/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, must-revalidate" }
      ]
    },
    {
      "source": "/data-v2/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
